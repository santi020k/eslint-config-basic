{
  "name": "@santi020k/eslint-config-docs",
  "version": "1.6.0",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "description": "Astro Starlight documentation site for the @santi020k/eslint-config-basic monorepo",
  "type": "module",
  "scripts": {
    "docs:build": "node ../../scripts/prepare-starlight-docs.mjs && rm -rf .astro && astro build",
    "docs:dev": "node ../../scripts/prepare-starlight-docs.mjs && rm -rf .astro && astro dev",
    "docs:preview": "astro preview",
    "docs:clean": "rm -rf dist .astro src/content/docs/api/reference",
    "build": "echo \"No direct build step required\"",
    "dev": "echo \"No direct build step required\"",
    "clean": "rm -rf dist .astro node_modules",
    "check:exports": "echo \"No exports to check\"",
    "typecheck": "node ../../scripts/prepare-starlight-docs.mjs && rm -rf .astro && astro check",
    "test:a11y": "playwright test",
    "test:a11y:ui": "playwright test --ui",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/starlight": "^0.40.0",
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "astro": "^6.4.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git",
    "directory": "apps/docs"
  },
  "author": "santi020k",
  "license": "MIT"
}
