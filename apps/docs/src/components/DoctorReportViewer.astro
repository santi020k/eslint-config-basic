---
import { Alert, Badge, Button, Card, Field, Label, Textarea } from '@santi020k/lumen-astro'
---

<div class="s2k-tool" data-doctor-viewer>
  <Alert role="note">
    <strong>Your report stays private.</strong>
    <span>This viewer parses JSON locally in your browser and never uploads repository information.</span>
  </Alert>

  <Card as="section" class="s2k-tool-card">
    <div class="s2k-tool-card__heading">
      <span class="s2k-tool-card__step">1</span>
      <div>
        <h2>Run the doctor</h2>
        <p>Run this command in the affected repository, then paste the complete JSON response below.</p>
      </div>
    </div>
    <div class="s2k-code-output">
      <div class="s2k-code-output__bar">
        <span>Terminal</span>
        <Button type="button" variant="ghost" size="sm" data-doctor-copy-command>Copy</Button>
      </div>
      <pre tabindex="0"><code data-doctor-command>npx @santi020k/eslint-config-basic doctor --json</code></pre>
    </div>

    <Field controlId="doctor-json" describedBy="doctor-json-help">
      <Label for="doctor-json">Doctor JSON</Label>
      <Textarea id="doctor-json" rows={12} spellcheck="false" placeholder='{"status":"passed with warnings","issues":[],"warnings":[...]}' data-doctor-input />
      <small id="doctor-json-help">Expected fields include status, issues, warnings, packageManager, configFile, and workspaceProjects.</small>
    </Field>

    <div class="s2k-output-actions">
      <Button type="button" data-doctor-analyze>Analyze report</Button>
      <Button type="button" variant="outline" data-doctor-example>Load example</Button>
      <Button type="button" variant="ghost" data-doctor-clear>Clear</Button>
    </div>
    <p class="s2k-tool-status" role="status" aria-live="polite" data-doctor-status></p>
  </Card>

  <section class="s2k-doctor-results" aria-live="polite" aria-atomic="false" tabindex="-1" hidden data-doctor-results>
    <div class="s2k-doctor-summary">
      <div>
        <Badge data-doctor-badge>Status</Badge>
        <h2 data-doctor-heading>Report summary</h2>
      </div>
      <dl class="s2k-doctor-meta">
        <div><dt>Package manager</dt><dd data-doctor-package-manager>—</dd></div>
        <div><dt>Config file</dt><dd data-doctor-config>—</dd></div>
        <div><dt>Workspace projects</dt><dd data-doctor-workspaces>—</dd></div>
      </dl>
    </div>
    <div class="s2k-doctor-findings" data-doctor-findings></div>
  </section>
</div>

<script>
  type DoctorPayload = {
    configFile?: null | string
    issues?: unknown
    liteInstallCommand?: string
    packageManager?: string
    status?: string
    warnings?: unknown
    workspaceProjects?: unknown
  }

  type Guidance = {
    command?: string
    href: string
    label: string
  }

  const exampleReport = {
    configFile: 'eslint.config.mjs',
    issues: [],
    liteInstallCommand: 'pnpm add -D eslint @santi020k/eslint-config-lite @santi020k/eslint-config-react typescript',
    packageManager: 'pnpm',
    status: 'passed with warnings',
    warnings: [
      'Config still imports v1 framework packages. Run `basic-eslint migrate --write` or switch to framework booleans.',
      'No `lint` script found in package.json.',
      'Workspace packages were detected, but the root config does not use `projects` scoping.'
    ],
    workspaceProjects: ['packages/app', 'packages/shared']
  }

  const guidanceFor = (message: string, payload: DoctorPayload): Guidance => {
    const normalized = message.toLowerCase()

    if (normalized.includes('v1 framework')) {
      return {
        command: 'npx @santi020k/eslint-config-basic migrate --write',
        href: '/guide/migration-v1-to-v2/',
        label: 'Open migration guide'
      }
    }

    if (normalized.includes('no eslint.config')) {
      return {
        command: 'npx @santi020k/eslint-config-basic init',
        href: '/guide/cli/#usage',
        label: 'Create a config'
      }
    }

    if (normalized.includes('could not be loaded')) {
      return { command: 'npx eslint .', href: '/guide/troubleshooting/', label: 'Troubleshoot config loading' }
    }

    if (normalized.includes('workspace') || normalized.includes('projects scoping')) {
      return { href: '/guide/monorepo/', label: 'Configure the monorepo' }
    }

    if (normalized.includes('two eslint copies')) {
      return {
        command: `${payload.packageManager ?? 'pnpm'} dedupe`,
        href: '/guide/troubleshooting/#two-eslint-versions-are-installed',
        label: 'Resolve duplicate ESLint versions'
      }
    }

    if (normalized.includes('lite config') && payload.liteInstallCommand) {
      return { command: payload.liteInstallCommand, href: '/guide/lite-migration/', label: 'Review Lite setup' }
    }

    if (normalized.includes('lint script')) {
      return { href: '/guide/installation/', label: 'Review installation steps' }
    }

    return { href: '/guide/troubleshooting/', label: 'Open troubleshooting' }
  }

  const createFinding = (kind: 'issue' | 'warning', message: string, payload: DoctorPayload): HTMLElement => {
    const card = document.createElement('article')

    card.className = `s2k-doctor-finding s2k-doctor-finding--${kind}`

    const header = document.createElement('div')

    header.className = 's2k-doctor-finding__header'

    const label = document.createElement('strong')

    label.textContent = kind === 'issue' ? 'Issue' : 'Warning'

    const text = document.createElement('p')

    text.textContent = message

    header.append(label, text)

    card.append(header)

    const guidance = guidanceFor(message, payload)
    const actions = document.createElement('div')

    actions.className = 's2k-doctor-finding__actions'

    const link = document.createElement('a')

    link.className = 'ui-button ui-button--secondary ui-button--sm'

    link.href = guidance.href

    link.textContent = guidance.label

    actions.append(link)

    if (guidance.command) {
      const command = document.createElement('code')

      command.textContent = guidance.command

      const copy = document.createElement('button')

      copy.className = 'ui-button ui-button--ghost ui-button--sm'

      copy.type = 'button'

      copy.textContent = 'Copy fix'

      copy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(guidance.command ?? '')

        copy.textContent = 'Copied'
      })

      actions.append(command, copy)
    }

    card.append(actions)

    return card
  }

  const normalizeMessages = (value: unknown): string[] => {
    if (!Array.isArray(value)) return []

    return value.filter((item): item is string => typeof item === 'string')
  }

  const initializeDoctorViewer = (root: HTMLElement) => {
    if (root.dataset.ready === 'true') return

    root.dataset.ready = 'true'

    const input = root.querySelector<HTMLTextAreaElement>('[data-doctor-input]')
    const status = root.querySelector<HTMLElement>('[data-doctor-status]')
    const results = root.querySelector<HTMLElement>('[data-doctor-results]')
    const findings = root.querySelector<HTMLElement>('[data-doctor-findings]')

    root.querySelector('[data-doctor-copy-command]')?.addEventListener('click', async () => {
      const command = root.querySelector('[data-doctor-command]')?.textContent ?? ''

      await navigator.clipboard.writeText(command)

      if (status) status.textContent = 'Doctor command copied.'
    })

    root.querySelector('[data-doctor-example]')?.addEventListener('click', () => {
      if (input) input.value = JSON.stringify(exampleReport, null, 2)

      if (status) status.textContent = 'Example report loaded. Select Analyze report to continue.'
    })

    root.querySelector('[data-doctor-clear]')?.addEventListener('click', () => {
      if (input) input.value = ''

      if (results) results.hidden = true

      if (findings) findings.replaceChildren()

      if (status) status.textContent = 'Report cleared.'

      input?.focus()
    })

    root.querySelector('[data-doctor-analyze]')?.addEventListener('click', () => {
      if (!input || !status || !results || !findings) return

      let payload: DoctorPayload

      try {
        const parsed = JSON.parse(input.value) as unknown

        if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
          throw new TypeError('Doctor report must be a JSON object.')
        }

        payload = parsed as DoctorPayload
      } catch {
        status.textContent = 'The report is not valid JSON. Copy the complete output from doctor --json and try again.'

        results.hidden = true

        input.focus()

        return
      }

      const issues = normalizeMessages(payload.issues)
      const warnings = normalizeMessages(payload.warnings)
      const workspaces = normalizeMessages(payload.workspaceProjects)
      let reportStatus = 'passed'
      let badgeVariant = 'success'
      let headingText = 'Your setup passed'

      if (warnings.length > 0) {
        reportStatus = 'passed with warnings'

        badgeVariant = 'warning'

        headingText = `${warnings.length} warning${warnings.length === 1 ? '' : 's'} to review`
      }

      if (issues.length > 0) {
        reportStatus = 'failed'

        badgeVariant = 'destructive'

        headingText = `${issues.length} issue${issues.length === 1 ? '' : 's'} need attention`
      }

      if (typeof payload.status === 'string') reportStatus = payload.status

      const badge = root.querySelector<HTMLElement>('[data-doctor-badge]')

      if (badge) {
        badge.textContent = reportStatus

        badge.dataset.variant = badgeVariant

        badge.className = `ui-badge ui-badge--${badgeVariant}`
      }

      const heading = root.querySelector<HTMLElement>('[data-doctor-heading]')

      if (heading) heading.textContent = headingText

      const packageManager = root.querySelector<HTMLElement>('[data-doctor-package-manager]')
      const config = root.querySelector<HTMLElement>('[data-doctor-config]')
      const workspaceOutput = root.querySelector<HTMLElement>('[data-doctor-workspaces]')

      if (packageManager) packageManager.textContent = payload.packageManager ?? 'Unknown'

      if (config) config.textContent = payload.configFile ?? 'None'

      if (workspaceOutput) {
        workspaceOutput.textContent = workspaces.length > 0 ? workspaces.join(', ') : 'None detected'
      }

      const issueFindings = issues.map(message => createFinding('issue', message, payload))
      const warningFindings = warnings.map(message => createFinding('warning', message, payload))

      findings.replaceChildren(...issueFindings, ...warningFindings)

      if (issues.length === 0 && warnings.length === 0) {
        const passed = document.createElement('div')

        passed.className = 's2k-doctor-passed'

        const title = document.createElement('strong')

        title.textContent = 'No issues or warnings were reported.'

        const message = document.createElement('p')

        message.textContent = 'The config file, package setup, and detected workspace structure look healthy.'

        passed.append(title, message)

        findings.append(passed)
      }

      results.hidden = false

      status.textContent = 'Report analyzed.'

      results.focus()
    })
  }

  const initializeDoctorViewers = () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-doctor-viewer]')) initializeDoctorViewer(root)
  }

  initializeDoctorViewers()

  document.addEventListener('astro:page-load', initializeDoctorViewers)
</script>
