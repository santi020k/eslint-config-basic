---
import type { StarlightRouteData } from '@astrojs/starlight/route-data'
import StarlightMetadataHead from '@santi020k/og/astro/starlight'
import { serializeJsonLd, webPageSchema } from '@santi020k/og/schema'

const route: StarlightRouteData = Astro.locals.starlightRoute
const data = route.entry.data as Readonly<Record<string, unknown>>
const title = typeof data.title === 'string' ? data.title : route.siteTitle

const description = typeof data.description === 'string' && data.description.trim() ?
  data.description :
  `${title} documentation.`

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href
const indexable = Astro.url.pathname !== '/404' && Astro.url.pathname !== '/404/'

const schema = indexable ?
serializeJsonLd(webPageSchema({
  description,
  inLanguage: route.lang,
  name: title,
  url: canonical
})) :
undefined
---

<StarlightMetadataHead {...Astro.props}><slot /></StarlightMetadataHead>
<meta name="robots" content={indexable ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' : 'noindex, nofollow'} />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{schema && <script type="application/ld+json" is:inline set:html={schema} />}
<link id="s2k-theme-favicon" rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
<meta id="s2k-theme-color" name="theme-color" content="#faf9fb" />
<script is:inline>
  (() => {
    const favicon = document.querySelector('#s2k-theme-favicon')
    const themeColor = document.querySelector('#s2k-theme-color')
    const colorScheme = window.matchMedia('(prefers-color-scheme: dark)')

    if (!(favicon instanceof HTMLLinkElement) || !(themeColor instanceof HTMLMetaElement))
      return

    const updateThemeAssets = () => {
      const selectedTheme = document.documentElement.dataset.theme
      const isDark = selectedTheme === 'dark' || (!selectedTheme && colorScheme.matches)
      const href = isDark ? '/favicon-dark.svg' : '/favicon-light.svg'
      const color = isDark ? '#110c1d' : '#faf9fb'

      if (favicon.getAttribute('href') !== href)
        favicon.setAttribute('href', href)

      if (themeColor.content !== color)
        themeColor.content = color
    }

    updateThemeAssets()

    new MutationObserver(updateThemeAssets).observe(document.documentElement, {
      attributeFilter: ['data-theme'],
      attributes: true
    })

    colorScheme.addEventListener('change', updateThemeAssets)

    document.addEventListener('astro:page-load', updateThemeAssets)
  })()
</script>
