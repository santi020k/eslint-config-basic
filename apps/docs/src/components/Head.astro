---
import Default from '@astrojs/starlight/components/Head.astro'
import type { Props } from '@astrojs/starlight/props'

const trimOuterSlashes = (value: string) => value.replace(/^\/+|\/+$/g, '')

const safeDecodeURIComponent = (value: string) => {
  try {
    return decodeURIComponent(value)
  } catch {
    return value
  }
}

const getOgSlug = (pathname: string) => trimOuterSlashes(pathname)
  .split('/')
  .filter(Boolean)
  .map(segment => encodeURIComponent(safeDecodeURIComponent(segment)).replaceAll('%', '~'))
  .join('--')

const slug = getOgSlug(Astro.url.pathname)
const ogImagePath = `/og/${slug || 'index'}.webp`
const site = Astro.site ?? new URL('https://eslint.santi020k.com/')
const ogImageURL = new URL(ogImagePath, site).href
const pageTitle = Astro.props.entry?.data?.title ?? 'ESLint Config'
const ogImageAlt = `${pageTitle} — ESLint Config`
---

<Default {...Astro.props}><slot /></Default>
<link id="s2k-theme-favicon" rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
<meta id="s2k-theme-color" name="theme-color" content="#faf9fb" />
<script is:inline>
  (() => {
    const favicon = document.querySelector('#s2k-theme-favicon')
    const themeColor = document.querySelector('#s2k-theme-color')
    const colorScheme = window.matchMedia('(prefers-color-scheme: dark)')

    if (!(favicon instanceof HTMLLinkElement) || !(themeColor instanceof HTMLMetaElement))
      return

    const updateThemeAssets = () => {
      const selectedTheme = document.documentElement.dataset.theme
      const isDark = selectedTheme === 'dark' || (!selectedTheme && colorScheme.matches)
      const href = isDark ? '/favicon-dark.svg' : '/favicon-light.svg'
      const color = isDark ? '#110c1d' : '#faf9fb'

      if (favicon.getAttribute('href') !== href)
        favicon.setAttribute('href', href)

      if (themeColor.content !== color)
        themeColor.content = color
    }

    updateThemeAssets()

    new MutationObserver(updateThemeAssets).observe(document.documentElement, {
      attributeFilter: ['data-theme'],
      attributes: true
    })

    colorScheme.addEventListener('change', updateThemeAssets)

    document.addEventListener('astro:page-load', updateThemeAssets)
  })()
</script>
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={ogImageAlt} />
