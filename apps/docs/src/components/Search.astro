---
import StarlightSearch from '@astrojs/starlight/components/Search.astro'
---

<StarlightSearch />

<script>
  const frame = document.querySelector('site-search .dialog-frame')

  if (frame) {
    const label = document.createElement('label')

    label.className = 's2k-search-label'

    label.textContent = 'Search documentation'

    frame.prepend(label)

    const hint = document.createElement('p')

    hint.className = 's2k-search-hint'

    hint.id = 's2k-search-hint'

    hint.textContent = 'Search guides, frameworks, or packages. Try “installation” or “React”.'

    frame.append(hint)

    const connectLabel = (): boolean => {
      const input = frame.querySelector<HTMLInputElement>('input[type="text"]')

      if (!input) return false

      input.id ||= 's2k-docs-search-input'

      label.htmlFor = input.id

      input.setAttribute('aria-describedby', hint.id)

      const updateHint = (): void => {
        hint.hidden = input.value.trim().length > 0
      }

      input.addEventListener('input', updateHint)

      frame.addEventListener('click', event => {
        if (event.target instanceof Element && event.target.closest('.pagefind-ui__search-clear')) {
          queueMicrotask(updateHint)
        }
      })

      updateHint()

      if (frame.closest('dialog')?.open) input.focus()

      return true
    }

    if (!connectLabel()) {
      const observer = new MutationObserver(() => {
        if (connectLabel()) observer.disconnect()
      })

      observer.observe(frame, { childList: true, subtree: true })
    }
  }
</script>
