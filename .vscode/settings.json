{
  // Matches the print width configured in Prettier
  "editor.rulers": [80],

  // ESLint flat config opt-in
  "eslint.useFlatConfig": true,

  // Languages ESLint should validate — mirrors the Format integrations this project ships
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "markdown",
    "md",
    "mdx",
    "astro",
    "svelte",
    "vue",
    "graphql",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "toml",
    "html",
    "css"
  ],

  // Format on save/paste via ESLint (Prettier runs last through the ESLint integration)
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Language-specific default formatters
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[vue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[svelte]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[astro]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[css]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // TypeScript SDK — use the workspace-root TypeScript for consistency across all packages
  "typescript.tsdk": "node_modules/typescript/lib",
  "javascript.preferences.importModuleSpecifier": "project-relative",
  "typescript.preferences.importModuleSpecifier": "project-relative",
  "javascript.preferences.quoteStyle": "single",
  "typescript.preferences.quoteStyle": "single",

  // pnpm monorepo
  "npm.packageManager": "pnpm",

  // Trim trailing whitespace on save
  "files.trimTrailingWhitespace": true,

  // Vitest snapshot files
  "files.associations": {
    "*.shot": "jest-snapshot"
  },

  // Keep node_modules visible — useful when debugging peer dependency issues in this package
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": false
  },

  // Exclude generated/cache folders from search — improves speed significantly in a 26-package monorepo
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/coverage": true
  },

  // Exclude heavy folders from the file watcher to reduce CPU usage
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true
  }
}
