{
  "name": "@santi020k/eslint-config-basic-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:schema": "ts-json-schema-generator -p packages/core/src/types.ts -t EslintConfigOptions -o eslint-config-schema.json",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "pnpm run build && turbo run test",
    "test:run": "pnpm --filter @santi020k/eslint-config-tests run test",
    "test:coverage": "pnpm run build && turbo run test:coverage",
    "lint": "pnpm run build && pnpm run lint:repo && turbo run lint",
    "lint:repo": "eslint . --cache --no-warn-ignored",
    "lint:fix": "pnpm run build && pnpm run lint:repo:fix && turbo run lint:fix",
    "lint:repo:fix": "eslint . --cache --fix --no-warn-ignored",
    "lint:changed": "node scripts/lint-changed-files.mjs",
    "lint:changed:fix": "node scripts/lint-changed-files.mjs --fix",
    "lint:spell": "cspell \"**\" --gitignore --cache --show-suggestions --show-context",
    "lint:knip": "knip",
    "ok": "pnpm install --reporter=silent && TURBO_LOG_ORDER=grouped pnpm run build && pnpm run test:run && pnpm run lint:repo && TURBO_LOG_ORDER=grouped turbo run lint && TURBO_LOG_ORDER=grouped pnpm run typecheck",
    "inspector": "eslint-config-inspector",
    "docs": "pnpm run docs:build",
    "docs:build": "pnpm run docs:api && pnpm --filter @santi020k/eslint-config-docs run docs:build",
    "docs:dev": "pnpm run docs:api && pnpm --filter @santi020k/eslint-config-docs run docs:dev",
    "docs:preview": "pnpm --filter @santi020k/eslint-config-docs run docs:preview",
    "docs:api": "node scripts/generate-api-docs.mjs && pnpm run docs:sync-changelog",
    "docs:sync-readmes": "node scripts/generate-package-readmes.mjs",
    "docs:sync-changelog": "node scripts/sync-docs-changelog.mjs",
    "docs:test": "pnpm run docs:test:a11y && pnpm --filter @santi020k/eslint-config-docs run lighthouse",
    "docs:test:a11y": "pnpm --filter @santi020k/eslint-config-docs run test:a11y",
    "docs:clean": "pnpm --filter @santi020k/eslint-config-docs run docs:clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check:exports": "turbo run check:exports",
    "check:package-metrics": "node scripts/package-metrics.mjs",
    "check:publish-dry-run": "node scripts/check-publish-dry-run.mjs",
    "check:attw": "node scripts/check-attw.mjs",
    "release:check": "TURBO_LOG_ORDER=grouped pnpm run build && pnpm run check:exports && pnpm run check:package-metrics && pnpm run check:publish-dry-run && pnpm run check:attw && pnpm run typecheck && pnpm run test:run",
    "release": "pnpm run release:check && changeset publish",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run lint && pnpm run lint:spell && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@eslint/config-inspector": "catalog:",
    "@santi020k/eslint-config-basic": "workspace:^",
    "@types/node": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "tailwindcss": "catalog:",
    "ts-json-schema-generator": "catalog:",
    "turbo": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,yaml,yml,toml,vue,svelte,astro}": [
      "cspell --no-must-find-files"
    ],
    "*.{js,jsx,ts,tsx,md,mdx,vue,svelte,astro}": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git"
  },
  "homepage": "https://eslint.santi020k.com/",
  "author": "santi020k",
  "license": "MIT"
}
