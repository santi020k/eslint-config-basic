{
  "name": "@santi020k/eslint-config-formats",
  "version": "2.1.1",
  "publishConfig": { "access": "public", "provenance": true },
  "description": "Non-JavaScript format configs for eslint-config-basic",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check:exports": "publint",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint . --no-warn-ignored --pass-on-no-patterns",
    "lint:fix": "eslint . --fix --no-warn-ignored --pass-on-no-patterns",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/css": "catalog:",
    "@eslint/markdown": "catalog:",
    "@graphql-eslint/eslint-plugin": "catalog:",
    "@html-eslint/eslint-plugin": "catalog:",
    "@html-eslint/parser": "catalog:",
    "@santi020k/eslint-config-core": "workspace:^",
    "@typescript-eslint/utils": "catalog:",
    "eslint-plugin-jsonc": "catalog:",
    "eslint-plugin-mdx": "catalog:",
    "eslint-plugin-package-json": "catalog:",
    "eslint-plugin-toml": "catalog:",
    "eslint-plugin-yml": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "graphql": "catalog:",
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "graphql": "^16.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "graphql": { "optional": true },
    "typescript": { "optional": true }
  },
  "engines": { "node": ">=22.19.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git",
    "directory": "packages/formats"
  },
  "homepage": "https://eslint.santi020k.com/tooling/formats",
  "license": "MIT"
}
