{
  "name": "@santi020k/eslint-config-vue",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Vue ESLint configuration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check:exports": "publint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-warn-ignored --pass-on-no-patterns",
    "lint:fix": "eslint . --fix --no-warn-ignored --pass-on-no-patterns"
  },
  "dependencies": {
    "eslint-plugin-vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "@typescript-eslint/utils": "catalog:"
  },
  "devDependencies": {
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git",
    "directory": "packages/vue"
  },
  "homepage": "https://eslint.santi020k.com/frameworks/vue.html",
  "bugs": {
    "url": "https://github.com/santi020k/eslint-config-basic/issues"
  },
  "author": "santi020k",
  "license": "MIT"
}
