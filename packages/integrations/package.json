{
  "name": "@santi020k/eslint-config-integrations",
  "version": "3.1.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Deprecated v3 compatibility aggregate; use the category feature packs directly",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./libraries": {
      "types": "./dist/libraries.d.ts",
      "import": "./dist/libraries.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "check:exports": "publint",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint . --no-warn-ignored --pass-on-no-patterns",
    "lint:fix": "eslint . --fix --no-warn-ignored --pass-on-no-patterns",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@santi020k/eslint-config-core": "workspace:^",
    "@santi020k/eslint-config-extensions": "workspace:^",
    "@santi020k/eslint-config-formats": "workspace:^",
    "@santi020k/eslint-config-libraries": "workspace:^",
    "@santi020k/eslint-config-testing": "workspace:^",
    "@santi020k/eslint-config-tools": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git",
    "directory": "packages/integrations"
  },
  "homepage": "https://eslint.santi020k.com/packages/integrations",
  "license": "MIT"
}
