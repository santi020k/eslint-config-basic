{
  "name": "@santi020k/eslint-config-integrations",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "ESLint integrations for libraries, tools, testing, formats, and extensions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./libraries": {
      "types": "./dist/libraries/index.d.ts",
      "import": "./dist/libraries/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "import": "./dist/formats/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check:exports": "publint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cspell/eslint-plugin": "^10.0.1",
    "@darraghor/eslint-plugin-nestjs-typed": "^7.2.4",
    "@eslint/compat": "^2.1.0",
    "@eslint/css": "^1.3.0",
    "@eslint/markdown": "^8.0.2",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@html-eslint/eslint-plugin": "^0.62.0",
    "@html-eslint/parser": "^0.62.0",
    "@santi020k/eslint-config-core": "workspace:*",
    "@stencil-community/eslint-plugin": "^0.10.0",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@typescript-eslint/utils": "^8.61.0",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint-config-biome": "^2.1.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-command": "^3.5.2",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-de-morgan": "^2.1.2",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-oxlint": "^1.69.0",
    "eslint-plugin-package-json": "^1.3.0",
    "eslint-plugin-pnpm": "^1.6.1",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-storybook": "^10.4.4",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-toml": "^1.4.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-turbo": "^2.9.18",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-vercel-ai-security": "^1.3.5",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "eslint-plugin-yml": "^3.4.0",
    "eslint-plugin-zod": "^4.7.0",
    "globals": "^17.6.0",
    "storybook": "^10.4.4",
    "typescript-eslint": "^8.61.0"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "publint": "^0.3.21",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git",
    "directory": "packages/integrations"
  },
  "homepage": "https://eslint.santi020k.com/packages/integrations.html",
  "bugs": {
    "url": "https://github.com/santi020k/eslint-config-basic/issues"
  },
  "author": "santi020k",
  "license": "MIT"
}
