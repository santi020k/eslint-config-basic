{
  "name": "@santi020k/eslint-config-basic",
  "version": "3.2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Lean, auto-detecting ESLint 10 flat config with opt-in framework and integration packages.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/recommended.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent-skill-generator.d.ts",
      "import": "./dist/agent-skill-generator.js"
    },
    "./recommended": {
      "types": "./dist/recommended.d.ts",
      "import": "./dist/recommended.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "IMPROVEMENTS.md"
  ],
  "bin": {
    "basic-eslint": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "build:pack": "npm pack",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check:exports": "publint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-warn-ignored --pass-on-no-patterns --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --pass-on-no-patterns --max-warnings=0"
  },
  "dependencies": {
    "@santi020k/eslint-config-core": "workspace:^",
