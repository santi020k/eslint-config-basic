{
  "name": "@santi020k/eslint-config-basic",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A composable ESLint 9/10+ Flat Config package for JavaScript, TypeScript, React, Next.js, Vue, Svelte, Solid, Angular, Astro, Expo, NestJS, Hono, Qwik, and Remix.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "basic-eslint": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "build:pack": "npm pack",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check:exports": "publint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@santi020k/eslint-config-angular": "workspace:^",
    "@santi020k/eslint-config-astro": "workspace:^",
    "@santi020k/eslint-config-core": "workspace:^",
    "@santi020k/eslint-config-expo": "workspace:^",
    "@santi020k/eslint-config-hono": "workspace:^",
    "@santi020k/eslint-config-lit": "workspace:^",
    "@santi020k/eslint-config-nest": "workspace:^",
    "@santi020k/eslint-config-next": "workspace:^",
    "@santi020k/eslint-config-nuxt": "workspace:^",
    "@santi020k/eslint-config-integrations": "workspace:^",
    "@santi020k/eslint-config-qwik": "workspace:^",
    "@santi020k/eslint-config-react": "workspace:^",
    "@santi020k/eslint-config-react-router": "workspace:^",
    "@santi020k/eslint-config-remix": "workspace:^",
    "@santi020k/eslint-config-slidev": "workspace:^",
    "@santi020k/eslint-config-solid": "workspace:^",
    "@santi020k/eslint-config-svelte": "workspace:^",
    "@santi020k/eslint-config-tanstack-start": "workspace:^",
    "@santi020k/eslint-config-typescript": "workspace:^",
    "@santi020k/eslint-config-vite": "workspace:^",
    "@santi020k/eslint-config-vue": "workspace:^",
    "@typescript-eslint/utils": "^8.61.0"
  },
  "devDependencies": {
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git",
    "directory": "packages/basic"
  },
  "homepage": "https://eslint.santi020k.com/packages/basic.html",
  "bugs": {
    "url": "https://github.com/santi020k/eslint-config-basic/issues"
  },
  "author": "santi020k",
  "license": "MIT"
}
