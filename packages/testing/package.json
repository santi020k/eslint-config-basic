{
  "name": "@santi020k/eslint-config-testing",
  "version": "2.1.1",
  "description": "Testing ESLint configs for eslint-config-basic",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "check:exports": "publint",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint . --no-warn-ignored --pass-on-no-patterns",
    "lint:fix": "eslint . --fix --no-warn-ignored --pass-on-no-patterns",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@santi020k/eslint-config-core": "workspace:^",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint-plugin-cypress": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-jest-dom": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "globals": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": { "optional": true }
  },
  "engines": { "node": "^20.19.0 || >=22.18.0" },
  "publishConfig": { "access": "public", "provenance": true },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git",
    "directory": "packages/testing"
  },
  "homepage": "https://eslint.santi020k.com/packages/testing",
  "license": "MIT"
}
