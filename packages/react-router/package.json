{
  "name": "@santi020k/eslint-config-react-router",
  "version": "1.6.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "React Router v7 (framework mode) ESLint configuration, successor to the Remix config",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check:exports": "publint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@santi020k/eslint-config-core": "workspace:^",
    "@typescript-eslint/utils": "^8.61.0",
    "eslint-plugin-jsx-a11y": "^6.10.2"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/eslint-config-basic.git",
    "directory": "packages/react-router"
  },
  "homepage": "https://eslint.santi020k.com/frameworks/react-router.html",
  "bugs": {
    "url": "https://github.com/santi020k/eslint-config-basic/issues"
  },
  "author": "santi020k",
  "license": "MIT"
}
