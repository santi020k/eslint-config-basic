{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": [
    "packages/playground",
    "packages/playground/**"
  ],
  "ignoreDependencies": [
    "@santi020k/eslint-config-basic",
    "typedoc-plugin-markdown",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["config/*.mjs", "typedoc.markdown.mjs"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/playground": {
      "project": []
    },
    "packages/playground/*": {
      "project": ["src/**/*.{js,jsx,ts,tsx,vue,svelte,astro}"]
    },
    "apps/docs": {
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/tests": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/basic": {
      "ignoreDependencies": []
    },
    "packages/integrations": {
      "ignoreDependencies": [
        "@eslint/markdown",
        "@graphql-eslint/eslint-plugin",
        "@tanstack/eslint-plugin-query",
        "@tanstack/eslint-plugin-router",
        "@vitest/eslint-plugin",
        "eslint-plugin-better-tailwindcss",
        "eslint-plugin-jsdoc",
        "eslint-plugin-playwright",
        "eslint-plugin-security",
        "eslint-plugin-sonarjs",
        "eslint-plugin-vercel-ai-security"
      ]
    },
    "packages/expo": {
      "ignoreDependencies": ["eslint-config-expo"]
    }
  }

}
