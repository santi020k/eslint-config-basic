{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": [
    "packages/playground",
    "packages/playground/**"
  ],
  "ignoreDependencies": [
    "typedoc-plugin-markdown",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "typedoc.markdown.mjs"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/playground": {
      "project": []
    },
    "packages/playground/*": {
      "project": ["src/**/*.{js,jsx,ts,tsx,vue,svelte,astro}"]
    },
    "apps/docs": {
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/tests": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/basic": {
      "ignoreDependencies": [
        "@santi020k/eslint-config-angular",
        "@santi020k/eslint-config-astro",
        "@santi020k/eslint-config-expo",
        "@santi020k/eslint-config-hono",
        "@santi020k/eslint-config-lit",
        "@santi020k/eslint-config-nest",
        "@santi020k/eslint-config-next",
        "@santi020k/eslint-config-nuxt",
        "@santi020k/eslint-config-preact",
        "@santi020k/eslint-config-qwik",
        "@santi020k/eslint-config-react",
        "@santi020k/eslint-config-react-router",
        "@santi020k/eslint-config-remix",
        "@santi020k/eslint-config-slidev",
        "@santi020k/eslint-config-solid",
        "@santi020k/eslint-config-svelte",
        "@santi020k/eslint-config-tanstack-start",
        "@santi020k/eslint-config-vite",
        "@santi020k/eslint-config-vue"
      ]
    },
    "packages/integrations": {
      "ignoreDependencies": [
        "@eslint/css",
        "@eslint/markdown",
        "@graphql-eslint/eslint-plugin",
        "@html-eslint/eslint-plugin",
        "@html-eslint/parser",
        "@tanstack/eslint-plugin-query",
        "@tanstack/eslint-plugin-router",
        "@vitest/eslint-plugin",
        "eslint-config-biome",
        "eslint-plugin-better-tailwindcss",
        "eslint-plugin-compat",
        "eslint-plugin-de-morgan",
        "eslint-plugin-depend",
        "eslint-plugin-jsdoc",
        "eslint-plugin-n",
        "eslint-plugin-no-only-tests",
        "eslint-plugin-oxlint",
        "eslint-plugin-playwright",
        "eslint-plugin-pnpm",
        "eslint-plugin-security",
        "eslint-plugin-sonarjs",
        "eslint-plugin-tsdoc",
        "eslint-plugin-vercel-ai-security",
        "eslint-plugin-zod",
        "graphql",
        "zod"
      ]
    },
    "packages/lite": {
      "ignoreDependencies": [
        "@santi020k/eslint-config-angular",
        "@santi020k/eslint-config-astro",
        "@santi020k/eslint-config-expo",
        "@santi020k/eslint-config-hono",
        "@santi020k/eslint-config-integrations",
        "@santi020k/eslint-config-lit",
        "@santi020k/eslint-config-nest",
        "@santi020k/eslint-config-next",
        "@santi020k/eslint-config-nuxt",
        "@santi020k/eslint-config-preact",
        "@santi020k/eslint-config-qwik",
        "@santi020k/eslint-config-react",
        "@santi020k/eslint-config-react-router",
        "@santi020k/eslint-config-remix",
        "@santi020k/eslint-config-slidev",
        "@santi020k/eslint-config-solid",
        "@santi020k/eslint-config-svelte",
        "@santi020k/eslint-config-tanstack-start",
        "@santi020k/eslint-config-vite",
        "@santi020k/eslint-config-vue"
      ]
    },
    "packages/react-router": {
      "ignoreDependencies": ["@santi020k/eslint-config-core"]
    },
    "packages/expo": {
      "ignoreDependencies": ["eslint-config-expo"]
    }
  }

}
