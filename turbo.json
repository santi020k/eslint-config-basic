{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CI_BASE_SHA",
    "DOCS_ROOT",
    "ESLINT_BASIC_DEBUG",
    "TURBO_SCM_BASE",
    "VITEST"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "@santi020k/eslint-config-docs#build": {
      "outputs": []
    },
    "@santi020k/eslint-config-tests#build": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "@santi020k/eslint-config-basic#build"],
      "outputLogs": "errors-only"
    },
    "lint:fix": {
      "dependsOn": ["^build", "@santi020k/eslint-config-basic#build"],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "check:exports": {
      "dependsOn": ["build"],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "outputLogs": "errors-only"
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "outputLogs": "errors-only"
    },
    "//#build:schema": {
      "inputs": ["packages/core/src/types.ts"],
      "outputs": ["eslint-config-schema.json"]
    },
    "//#lint:spell": {
      "outputLogs": "errors-only"
    },
    "//#lint:knip": {
      "outputLogs": "errors-only"
    },
    "//#lint:repo": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  },
  "futureFlags": {
    "errorsOnlyShowHash": true
  }
}
